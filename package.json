{
  "name": "job-scout",
  "version": "0.1.0",
  "description": "Self-hosted Telegram bot that finds fresh job postings, filters them against your profile and lets you act on each one in a single tap.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev:bot": "tsx watch src/bot/main.ts",
    "dev:worker": "tsx watch src/worker/main.ts",
    "start:bot": "node dist/bot/main.js",
    "start:worker": "node dist/worker/main.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "config:check": "tsx scripts/check-config.ts",
    "docs:config": "tsx scripts/gen-config-docs.ts",
    "docs:config:check": "tsx scripts/gen-config-docs.ts --check"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.14.0",
    "drizzle-orm": "^0.45.4",
    "fast-xml-parser": "^5.12.1",
    "grammy": "^1.48.0",
    "html-to-text": "^10.0.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.6.0",
    "@eslint/js": "^10.0.1",
    "@types/html-to-text": "^9.0.4",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.1.1"
  },
  "packageManager": "pnpm@12.16.1"
}
